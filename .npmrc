# Project-level registry pin. Overrides ~/.npmrc for this repo only.
# The lockfile's `resolved` URLs get baked in from the registry active at the
# time of `npm install`, and GitHub Actions runners must be able to reach them —
# so this must stay the public npm registry, not any internal mirror.
# Contributors behind a corporate proxy that requires an internal mirror should
# set NPM_CONFIG_REGISTRY in their shell env instead of editing this file.
registry=https://registry.npmjs.org/
